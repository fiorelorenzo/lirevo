{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "local-dictation-app",
  "version": "0.4.0",
  "identifier": "app.localdictation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray/tray-loading.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["icons/tray/*.png"],
    "category": "Productivity",
    "shortDescription": "Local, private dictation for macOS",
    "longDescription": "Push-to-talk dictation that runs fully on-device.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "frameworks": []
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [],
      "dialog": false,
      "pubkey": ""
    }
  }
}
